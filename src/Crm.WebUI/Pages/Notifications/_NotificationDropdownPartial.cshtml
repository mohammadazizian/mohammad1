@model Crm.Application.Features.Collaboration.NotificationListDto
@* Bell dropdown. data-unread lets site.js keep the navbar badge in sync after each swap. *@
<div data-unread="@Model.UnreadCount">
    <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
        <span class="fw-semibold">@L["Notifications"]</span>
        @if (Model.UnreadCount > 0)
        {
            <button class="btn btn-sm btn-link p-0" hx-post="/Notifications?handler=Read&dropdown=true" hx-target="#notificationDropdown">@L["Mark all as read"]</button>
        }
    </div>
    <div style="max-block-size: 380px; overflow-y: auto">
        <partial name="_NotificationListPartial" model="Model" />
    </div>
    <a class="d-block text-center py-2 small fw-medium" href="/Notifications">@L["View all"]</a>
</div>
