@page "{id:guid?}"
@model Crm.WebUI.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = L[Model.IsNew ? "New user" : "Edit user"];
}
<div class="page-header">
    <div>
        <a class="cell-sub" href="/Admin/Users"><i class="bi bi-chevron-@(Culture.IsRtl ? "right" : "left")"></i> @L["Users"]</a>
        <h1 class="mt-1">@ViewData["Title"]</h1>
    </div>
</div>

<form method="post" class="card" style="max-inline-size: 760px">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="Input.Id" />
        <div class="row g-3">
            <div class="col-md-6 required">
                <label class="form-label" asp-for="Input.FullName"></label>
                <input class="form-control" asp-for="Input.FullName" dir="auto" />
                <span asp-validation-for="Input.FullName"></span>
            </div>
            <div class="col-md-6 required">
                <label class="form-label" asp-for="Input.UserName"></label>
                <input class="form-control" asp-for="Input.UserName" dir="ltr" autocomplete="off" />
                <span asp-validation-for="Input.UserName"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Input.Email"></label>
                <input class="form-control" asp-for="Input.Email" type="email" dir="ltr" />
                <span asp-validation-for="Input.Email"></span>
            </div>
            <div class="col-md-6 @(Model.IsNew ? "required" : null)">
                <label class="form-label" asp-for="Input.Password"></label>
                <input class="form-control" asp-for="Input.Password" dir="ltr" autocomplete="new-password" />
                <span asp-validation-for="Input.Password"></span>
                @if (!Model.IsNew)
                {
                    <div class="form-text">@L["Leave empty to keep the current password."]</div>
                }
            </div>
            <div class="col-12">
                <label class="form-label d-block">@L["Roles"]</label>
                @foreach (var role in Model.Roles)
                {
                    <label class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="Input.Roles" value="@role.Name" checked="@Model.Input.Roles.Contains(role.Name)" />
                        <span class="form-check-label">@role.Name</span>
                    </label>
                }
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input class="form-check-input" asp-for="Input.IsActive" />
                    <label class="form-check-label" asp-for="Input.IsActive"></label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2 justify-content-end">
        <a class="btn btn-light" href="/Admin/Users">@L["Cancel"]</a>
        <button type="submit" class="btn btn-primary">@L["Save"]</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
