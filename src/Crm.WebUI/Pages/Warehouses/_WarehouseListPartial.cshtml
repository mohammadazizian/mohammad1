@model Crm.WebUI.Pages.Warehouses.IndexModel
<table class="table">
    <thead>
        <tr>
            <th>@L["Code"]</th>
            <th>@L["Name"]</th>
            <th>@L["Location"]</th>
            <th class="text-end">@L["Total quantity"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var warehouse in Model.Warehouses)
        {
            <tr>
                <td dir="ltr" class="text-start fw-semibold">@warehouse.Code</td>
                <td dir="auto">@warehouse.Name</td>
                <td class="cell-sub" dir="auto">@warehouse.Location</td>
                <td class="text-end num">@Fmt.Number(warehouse.TotalQuantity)</td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-link text-muted p-0" title="@L["Delete"]" asp-permission="Inventory.Delete"
                            hx-post="/Warehouses?handler=Delete&id=@warehouse.Id" hx-target="#warehouses" hx-confirm="@L["Are you sure?"]">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (Model.CanEdit)
{
    <form class="row g-2 p-3 border-top" hx-post="/Warehouses?handler=Save" hx-target="#warehouses">
        <div class="col-3"><input class="form-control text-uppercase" name="Code" placeholder="@L["Code"]" required maxlength="16" dir="ltr" /></div>
        <div class="col"><input class="form-control" name="Name" placeholder="@L["Name"]" required maxlength="100" dir="auto" /></div>
        <div class="col"><input class="form-control" name="Location" placeholder="@L["Location"]" maxlength="200" dir="auto" /></div>
        <div class="col-auto"><button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>@L["Add"]</button></div>
    </form>
}
