@page
@model Crm.WebUI.Pages.Products.IndexModel
@{
    ViewData["Title"] = L["Products"];
}
<div class="page-header">
    <div>
        <h1>@L["Products"]</h1>
        <p class="page-subtitle">@L["Catalogue, prices and stock on hand."]</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" href="/Products/Categories"><i class="bi bi-tags me-1"></i>@L["Categories"]</a>
        <a class="btn btn-primary" href="/Products/Edit" asp-permission="Products.Create"><i class="bi bi-plus-lg me-1"></i>@L["New product"]</a>
    </div>
</div>

<div class="card table-card">
    <form class="d-flex flex-wrap align-items-center gap-2 p-3 border-bottom" method="get"
          hx-get="/Products" hx-target="#list" hx-push-url="true"
          hx-trigger="input changed delay:300ms from:find input[type=search], change from:find select, change from:find input[type=checkbox], submit">
        <div class="search-box flex-grow-1">
            <i class="bi bi-search"></i>
            <input type="search" class="form-control" name="q" value="@Model.Q" placeholder="@L["Search by name or SKU…"]" aria-label="@L["Search"]" />
        </div>
        <select class="form-select w-auto" name="categoryId" aria-label="@L["Category"]">
            <option value="">@L["All categories"]</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name.Get(Culture.CultureName)</option>
            }
        </select>
        <label class="form-check mb-0 ms-1">
            <input class="form-check-input" type="checkbox" name="lowStock" value="true" checked="@Model.LowStock" />
            <span class="form-check-label">@L["Low stock only"]</span>
        </label>
    </form>
    <div id="list">
        <partial name="_ListPartial" model="Model" />
    </div>
</div>
