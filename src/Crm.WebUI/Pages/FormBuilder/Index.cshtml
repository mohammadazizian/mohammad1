@page
@model Crm.WebUI.Pages.FormBuilder.IndexModel
@{
    ViewData["Title"] = L["Form builder"];
}
<div class="page-header">
    <div>
        <h1>@L["Form builder"]</h1>
        <p class="page-subtitle">@L["Design custom forms. Each form gets its own menu entry, permissions and collaboration tools."]</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/FormBuilder/Edit" asp-permission="Forms.Create"><i class="bi bi-plus-lg me-1"></i>@L["New form"]</a>
    </div>
</div>

@if (Model.Forms.Count == 0)
{
    <div class="card"><div class="empty-state"><i class="bi bi-ui-checks-grid"></i>@L["No forms yet."]</div></div>
}

<div class="row g-3">
    @foreach (var form in Model.Forms)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                        <h2 class="h6 mb-0">@form.Title.Get(Culture.CultureName)</h2>
                        <span class="pill @(form.IsPublished ? "pill-success" : null)">@L[form.IsPublished ? "Published" : "Draft"]</span>
                    </div>
                    <code class="small" dir="ltr">@form.Code</code>
                    <p class="text-muted small mt-2 flex-grow-1">@form.Description.Get(Culture.CultureName)</p>
                    <div class="cell-sub mb-3">@L["{0} fields", Fmt.Number(form.FieldCount)] · @L["{0} entries", Fmt.Number(form.SubmissionCount)]</div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-light" href="/Forms/Submissions/@form.Code"><i class="bi bi-list-ul me-1"></i>@L["Entries"]</a>
                        <a class="btn btn-sm btn-light" href="/FormBuilder/Edit/@form.Id" asp-permission="Forms.Edit"><i class="bi bi-pencil me-1"></i>@L["Design"]</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@form.Id" class="ms-auto" asp-permission="Forms.Delete"
                              data-confirm="@L["Delete this form and all of its entries?"]">
                            <button type="submit" class="btn btn-sm btn-light text-danger" title="@L["Delete"]"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
