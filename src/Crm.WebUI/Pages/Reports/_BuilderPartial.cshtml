@using Crm.Application.Features.Reports
@model Crm.WebUI.Pages.Reports.IndexModel
@* Options of one data set. Swapped by htmx whenever another data set is chosen. *@
@{
    var columns = Model.Source.Columns;
    var numeric = columns.Where(c => c.IsNumeric).ToList();
}
<input type="hidden" name="Definition.Source" value="@Model.Source.Key" />

<div class="drawer-section-title">@L["Columns"]</div>
<div class="row g-1 mb-3">
    @foreach (var column in columns)
    {
        <div class="col-6">
            <label class="form-check mb-0">
                <input class="form-check-input" type="checkbox" name="Definition.Columns" value="@column.Key" checked="@Model.Definition.Columns.Contains(column.Key)" />
                <span class="form-check-label">@Model.ColumnLabel(column)</span>
            </label>
        </div>
    }
</div>

<div class="drawer-section-title">@L["Filters"]</div>
@for (var i = 0; i < Crm.WebUI.Pages.Reports.IndexModel.FilterSlots; i++)
{
    <div class="row g-1 mb-2">
        <div class="col-4">
            <select class="form-select form-select-sm" name="Definition.Filters[@i].Column" aria-label="@L["Column"]">
                <option value="">—</option>
                @foreach (var column in columns)
                {
                    <option value="@column.Key">@Model.ColumnLabel(column)</option>
                }
            </select>
        </div>
        <div class="col-4">
            <select class="form-select form-select-sm" name="Definition.Filters[@i].Operator" aria-label="@L["Operator"]">
                @foreach (var op in ReportOperators.All)
                {
                    <option value="@op">@L["op_" + op]</option>
                }
            </select>
        </div>
        <div class="col-4">
            <input class="form-control form-control-sm" name="Definition.Filters[@i].Value" placeholder="@L["Value"]" dir="auto" aria-label="@L["Value"]" />
        </div>
    </div>
}
<div class="form-text mb-3">@L["Dates as YYYY-MM-DD; yes/no as true/false."]</div>

<div class="row g-2 mb-3">
    <div class="col-8">
        <label class="form-label">@L["Sort by"]</label>
        <select class="form-select form-select-sm" name="Definition.SortBy">
            @foreach (var column in columns)
            {
                <option value="@column.Key">@Model.ColumnLabel(column)</option>
            }
        </select>
    </div>
    <div class="col-4 d-flex align-items-end">
        <label class="form-check mb-1"><input class="form-check-input" type="checkbox" name="Definition.SortDescending" value="true" /> <span class="form-check-label">@L["Descending"]</span></label>
    </div>
</div>

<div class="drawer-section-title">@L["Grouping & chart"]</div>
<div class="row g-2">
    <div class="col-6">
        <label class="form-label">@L["Group by"]</label>
        <select class="form-select form-select-sm" name="Definition.GroupBy">
            <option value="">@L["No grouping"]</option>
            @foreach (var column in columns.Where(c => !c.IsNumeric))
            {
                <option value="@column.Key" selected="@(column.Type == ReportColumnType.Enum && column == columns.First(c => c.Type == ReportColumnType.Enum))">@Model.ColumnLabel(column)</option>
            }
        </select>
    </div>
    <div class="col-6">
        <label class="form-label">@L["Chart"]</label>
        <select class="form-select form-select-sm" name="Definition.Chart">
            @foreach (var chart in Enum.GetValues<ReportChartType>().Where(c => c != ReportChartType.None))
            {
                <option value="@chart">@L.Enum(chart)</option>
            }
        </select>
    </div>
    <div class="col-6">
        <label class="form-label">@L["Calculate"]</label>
        <select class="form-select form-select-sm" name="Definition.Aggregate">
            @foreach (var aggregate in Enum.GetValues<ReportAggregate>())
            {
                <option value="@aggregate">@L.Enum(aggregate)</option>
            }
        </select>
    </div>
    <div class="col-6">
        <label class="form-label">@L["Of column"]</label>
        <select class="form-select form-select-sm" name="Definition.AggregateColumn">
            <option value="">—</option>
            @foreach (var column in numeric)
            {
                <option value="@column.Key">@Model.ColumnLabel(column)</option>
            }
        </select>
    </div>
</div>
