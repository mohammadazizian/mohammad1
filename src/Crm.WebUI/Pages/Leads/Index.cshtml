@page
@using Crm.Domain.Sales
@model Crm.WebUI.Pages.Leads.IndexModel
@{
    ViewData["Title"] = L["Leads"];
}
<div class="page-header">
    <div>
        <h1>@L["Leads"]</h1>
        <p class="page-subtitle">@L["Potential customers you are qualifying."]</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/Leads/Edit" asp-permission="Leads.Create"><i class="bi bi-plus-lg me-1"></i>@L["New lead"]</a>
    </div>
</div>

<div class="card table-card">
    <form class="d-flex flex-wrap gap-2 p-3 border-bottom" method="get"
          hx-get="/Leads" hx-target="#list" hx-push-url="true"
          hx-trigger="input changed delay:300ms from:find input, change from:find select, submit">
        <div class="search-box flex-grow-1">
            <i class="bi bi-search"></i>
            <input type="search" class="form-control" name="q" value="@Model.Q" placeholder="@L["Search by name, company or email…"]" aria-label="@L["Search"]" />
        </div>
        <select class="form-select w-auto" name="status" aria-label="@L["Status"]">
            <option value="">@L["All statuses"]</option>
            @foreach (var status in Enum.GetValues<LeadStatus>())
            {
                <option value="@status" selected="@(Model.Status == status)">@L.Enum(status)</option>
            }
        </select>
    </form>
    <div id="list">
        <partial name="_ListPartial" model="Model" />
    </div>
</div>
