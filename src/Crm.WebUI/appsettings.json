{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=CrmDb;User Id=sa;Password=Str0ng!Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Seed": {
    "ApplyMigrations": true,
    "DemoData": true,
    "AdminUserName": "admin",
    "AdminPassword": "Admin@12345",
    "AdminEmail": "admin@crm.local",
    "DemoPassword": "Demo@12345"
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [ "en-US", "fa-IR" ]
  },
  "Regional": {
    "TimeZone": "Asia/Tehran",
    "CurrencyFormatEn": "${0}",
    "CurrencyFormatFa": "{0} دلار",
    "CurrencyDecimals": 0
  },
  "Reminders": {
    "PollSeconds": 30
  },
  "Storage": {
    "Path": "App_Data/uploads",
    "MaxFileBytes": 10485760
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
