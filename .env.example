# Copy to ".env" and adjust. Never commit the real .env file.

# --- SQL Server --------------------------------------------------------------
# Must satisfy the SQL Server password policy (8+ chars, upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=Change_Me_Str0ng!Passw0rd
MSSQL_DATABASE=CrmDb
MSSQL_IMAGE_TAG=2022-latest        # or 2025-latest
MSSQL_PID=Developer
MSSQL_PORT=14330                   # host port of the database (for SSMS / Azure Data Studio)

# --- Application ---------------------------------------------------------------
APP_PORT=8080                      # http://localhost:8080
ASPNETCORE_ENVIRONMENT=Production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345         # change before exposing the app
DEMO_PASSWORD=Demo@12345           # password of the demo users sara / reza / mina
SEED_DEMO_DATA=true                # false = only roles, admin user and the default pipeline
DEFAULT_CULTURE=en-US              # en-US or fa-IR
TIME_ZONE=Asia/Tehran              # IANA time zone used to display dates
